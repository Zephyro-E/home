# Copia este archivo como .env para cambiar la configuración. Todo es opcional.

# Modo desarrollo (muestra errores detallados). Nunca activarlo al usar la app en casa.
HOGAR_DEBUG=0

# Clave secreta. Si no se indica, se genera sola en data/secret_key.txt.
# HOGAR_SECRET_KEY=

# Nombres o IPs desde los que se puede abrir la app (separados por comas).
# HOGAR_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50

# Origen(es) de confianza si se accede por HTTPS (p. ej. con Tailscale).
# HOGAR_CSRF_TRUSTED_ORIGINS=https://hogar.tu-red.ts.net

# Poner a 1 cuando la app se sirva por HTTPS.
# HOGAR_HTTPS=0

# Carpeta de datos (base de datos, imágenes, copias, registros). Por defecto: ./data
# HOGAR_DATA_DIR=
